# Vapi AtomS3R Voice — build-time config.
#
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# CMake loads it at configure time and bakes the values into the firmware,
# overriding anything set via `idf.py menuconfig`.
#
#   cp .env.example .env && $EDITOR .env
#
# After editing .env, just rebuild (`make run`) — the header is regenerated on
# every build. Values may be quoted; `export ` prefixes are allowed.

# --- Required ---------------------------------------------------------------

# WiFi the board joins on boot.
WIFI_SSID="my-wifi"
WIFI_PASSWORD="my-wifi-password"

# Vapi PRIVATE API key. Creating a call on the websocket transport goes through
# POST /call, which requires the private key — the public key only authorizes
# /call/web, which returns a Daily room this device cannot join.
#
# DEV ONLY. This is compiled into the image and recoverable from a flash dump,
# and a private key is account-wide: it can create calls, read transcripts and
# spend money. Do not put one on a device you would not hand to a stranger.
# For anything real, front it with a proxy that mints per-device tokens.
VAPI_API_KEY=""

# The assistant this device calls. Copy from the Vapi dashboard.
VAPI_ASSISTANT_ID=""

# --- Optional ---------------------------------------------------------------

# Vapi API base. Change only to point at a different environment.
VAPI_API_URL="https://api.vapi.ai"

# Greeting spoken on connect. Applied as a per-call override, so your saved
# assistant is never modified. Leave commented out to use the assistant's own.
#VAPI_FIRST_MESSAGE="Hey, I'm listening."

# Hard cap on one call, in seconds. Worth setting: a call left up by a missed
# button press bills until Vapi's own timeout.
#VAPI_MAX_DURATION_SECONDS="300"
